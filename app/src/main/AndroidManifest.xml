<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.RoomBooking">

        <activity
            android:name=".LoginActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- singleTop: reuse the open screen instead of making a new one -->
        <activity
            android:name=".MainActivity"
            android:exported="false"
            android:launchMode="singleTop" />
        <activity
            android:name=".FreeRoomsActivity"
            android:exported="false"
            android:parentActivityName=".MainActivity" />
        <activity
            android:name=".ConfirmRequestActivity"
            android:exported="false"
            android:parentActivityName=".FreeRoomsActivity" />
        <activity
            android:name=".RequestSentActivity"
            android:exported="false" />
        <activity
            android:name=".RoomUnavailableActivity"
            android:exported="false" />
    </application>

</manifest>
