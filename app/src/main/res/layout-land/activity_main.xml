<?xml version="1.0" encoding="utf-8"?>
<!-- Employee home, landscape: the two buttons become a column on the left -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal">

    <LinearLayout
        android:layout_width="140dp"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <Button
            android:id="@+id/btn_nav_find"
            android:layout_width="match_parent"
            android:layout_height="72dp"
            android:text="@string/nav_find_room"
            android:textColor="@color/nav_text_color"
            app:backgroundTint="@color/nav_bg_tint"
            app:cornerRadius="0dp" />

        <Button
            android:id="@+id/btn_nav_bookings"
            android:layout_width="match_parent"
            android:layout_height="72dp"
            android:text="@string/nav_my_bookings"
            android:textColor="@color/nav_text_color"
            app:backgroundTint="@color/nav_bg_tint"
            app:cornerRadius="0dp" />
    </LinearLayout>

    <FrameLayout
        android:id="@+id/fragment_container"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1" />
</LinearLayout>
