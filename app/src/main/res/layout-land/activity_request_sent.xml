<?xml version="1.0" encoding="utf-8"?>
<!-- Request sent, landscape: confirmation on the left, next actions on the right -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:padding="24dp"
    android:weightSum="2">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:gravity="center"
        android:orientation="vertical">

        <ImageView
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:contentDescription="@string/success_description"
            android:src="@drawable/ic_check_circle" />

        <TextView
            android:id="@+id/tv_sent_heading"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/sent_heading"
            android:textColor="@color/text_primary"
            android:textSize="24sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_details"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textColor="@color/text_primary"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/tv_status_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_chip_pending"
            android:paddingStart="10dp"
            android:paddingTop="4dp"
            android:paddingEnd="10dp"
            android:paddingBottom="4dp"
            android:text="@string/status_pending_approval"
            android:textColor="@color/text_primary" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:gravity="center"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tv_sent_note"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/sent_note"
            android:textColor="@color/text_secondary" />

        <Button
            android:id="@+id/btn_view_bookings"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="16dp"
            android:text="@string/view_my_bookings" />

        <Button
            android:id="@+id/btn_find_another"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="8dp"
            android:text="@string/find_another_room"
            android:backgroundTint="@color/card_bg"
            android:textColor="@color/text_primary"
            app:strokeColor="@color/stroke"
            app:strokeWidth="1dp" />

        <!-- Cancel request: cancel from this screen -->
        <Button
            android:id="@+id/btn_cancel_request"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="8dp"
            android:text="@string/cancel_request"
            android:backgroundTint="@color/card_bg"
            android:textColor="@color/text_primary"
            app:strokeColor="@color/stroke"
            app:strokeWidth="1dp" />
    </LinearLayout>
</LinearLayout>
