<?xml version="1.0" encoding="utf-8"?>
<!-- My bookings. Two buttons switch between Upcoming and Past, and a RecyclerView lists the bookings. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:weightSum="2">

        <Button
            android:id="@+id/btn_upcoming"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:layout_weight="1"
            android:textColor="@color/nav_text_color"
            app:backgroundTint="@color/nav_bg_tint"
            android:text="@string/tab_upcoming" />

        <Button
            android:id="@+id/btn_past"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:layout_weight="1"
            android:textColor="@color/nav_text_color"
            app:backgroundTint="@color/nav_bg_tint"
            android:text="@string/tab_past" />
    </LinearLayout>

    <TextView
        android:id="@+id/tv_empty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:gravity="center"
        android:textColor="@color/text_secondary"
        android:textSize="16sp"
        android:visibility="gone" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/bookings_list"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        android:layout_weight="1" />
</LinearLayout>
