<?xml version="1.0" encoding="utf-8"?>
<!-- Manager Requests page: two tab buttons, an empty message and a RecyclerView of requests. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp">

    <!-- Two buttons act as the Bookings / Cancellations tabs, each with its own count -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:weightSum="2">

        <Button
            android:id="@+id/btn_tab_bookings"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:layout_weight="1"
            android:textColor="@color/nav_text_color"
            app:backgroundTint="@color/nav_bg_tint" />

        <Button
            android:id="@+id/btn_tab_cancellations"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:layout_weight="1"
            android:textColor="@color/nav_text_color"
            app:backgroundTint="@color/nav_bg_tint" />
    </LinearLayout>

    <TextView
        android:id="@+id/tv_requests_empty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:gravity="center"
        android:text="@string/requests_empty"
        android:textColor="@color/text_secondary"
        android:textSize="16sp"
        android:visibility="gone" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/requests_list"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        android:layout_weight="1" />
</LinearLayout>
