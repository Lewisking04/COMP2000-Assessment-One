<?xml version="1.0" encoding="utf-8"?>
<!--
  Yellow "chip" behind the status text Pending approval. BookingAdapter picks this drawable in Java.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <solid android:color="@color/status_pending" />
    <stroke android:width="1dp" android:color="@color/stroke" />
    <corners android:radius="16dp" />
    <padding android:left="12dp" android:top="4dp" android:right="12dp" android:bottom="4dp" />
</shape>
